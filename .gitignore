# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# self-signed certs from `next dev --experimental-https`
/certificates

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# committed on purpose: only the public production Convex URL
!.env.production

# vercel
.vercel

# per-machine Claude Code permissions; shared config goes in .claude/settings.json
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
